{
  "manifest_version": 3,
  "name": "101 Downloader — Download companion",
  "version": "0.3.5",
  "description": "Capture Chromium browser file downloads and send them to your local 101 Downloader download manager.",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "downloads",
    "downloads.ui",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "101 Downloader",
    "default_icon": {
      "32": "icons/strata-32.png",
      "16": "icons/strata-16.png"
    }
  },
  "icons": {
    "32": "icons/strata-32.png",
    "48": "icons/strata-48.png",
    "128": "icons/strata-128.png",
    "16": "icons/strata-16.png"
  }
}
